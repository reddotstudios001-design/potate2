function Library:CreateWindow(opts)
	opts = opts or {}

	-- descarrega a instancia anterior se o script for executado de novo
	if Env and type(Env.__PotatoLibUnload) == "function" then
		pcall(Env.__PotatoLibUnload)
		Env.__PotatoLibUnload = nil
	end

	local W = {Flags = {}, Elements = {}, CustomThemes = {}}
	local Connections = {}
	local function Connect(signal, fn)
		local c = signal:Connect(fn)
		table.insert(Connections, c)
		return c
	end

	local TITLE = tostring(opts.Name or "potato")
	local VERSION = tostring(opts.Version or "1.0")
	local LOGO = opts.Logo
	if LOGO == nil then
		LOGO = DEFAULT_LOGO
	end
	local CONFIG_FOLDER = opts.ConfigFolder or "potato"
	local CONFIG_FILE = CONFIG_FOLDER .. "/" .. (opts.ConfigFile or "config.json")
	local EXPANDED_W = (opts.Size and opts.Size.X) or 760
	local EXPANDED_H = (opts.Size and opts.Size.Y) or 470
	local MIN_W, MIN_H = 195, 46
	local TAB_PAD = 10
	local DEFAULT_PANEL_W = 265
	local Changelog = type(opts.Changelog) == "table" and opts.Changelog or nil

	local wmOpts = opts.Watermark or {}
	local Defaults = {
		_Theme = opts.Theme or "Pitch Black",
		_Gradient = true,
		_GradientAngle = 45,
		_Scale = 100,
		_Transparency = 0,
		_ToggleKey = opts.ToggleKey or Enum.KeyCode.P,
		_Watermark = wmOpts.Enabled ~= false,
		_WmLogo = wmOpts.Logo ~= false,
		_WmFps = wmOpts.Fps ~= false,
		_WmPing = wmOpts.Ping == true,
		_WmUser = wmOpts.User ~= false,
		_WmTime = wmOpts.Time == true
	}
	local Ranges = {
		_GradientAngle = {0, 360},
		_Scale = {70, 130},
		_Transparency = {0, 75}
	}
	W.Defaults = Defaults

	local UI = {
		Tabs = {},
		TabOrder = {},
		DefaultTabOrder = {},
		ActiveTab = nil,
		IsMinimized = false,
		IsHidden = false,
		ChangelogOpen = false,
		TabEditMode = false,
		BindingKey = false,
		JustBound = false,
		Ready = false
	}
	W.Tabs = UI.Tabs

	----------------------------------------------------------------------
	-- CONFIG (ler / salvar)
	----------------------------------------------------------------------
	local HasFS = (opts.SaveConfig ~= false)
		and (typeof(writefile) == "function") and (typeof(readfile) == "function") and (typeof(isfile) == "function")

	local function ReadConfig()
		if not HasFS then
			return nil
		end
		local okExists, exists = pcall(isfile, CONFIG_FILE)
		if not okExists or not exists then
			return nil
		end
		local okRead, raw = pcall(readfile, CONFIG_FILE)
		if not okRead or type(raw) ~= "string" or raw == "" then
			return nil
		end
		local okJson, data = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not okJson or type(data) ~= "table" then
			return nil
		end
		return data
	end

	local function WriteConfig(data)
		if not HasFS then
			return false
		end
		pcall(function()
			if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(CONFIG_FOLDER) then
				makefolder(CONFIG_FOLDER)
			end
		end)
		local ok = pcall(function()
			writefile(CONFIG_FILE, HttpService:JSONEncode(data))
		end)
		return ok
	end

	local function LoadCustomThemes(saved, clearFirst)
		if clearFirst then
			for _, ct in ipairs(W.CustomThemes) do
				Themes[ct.Name] = nil
			end
			table.clear(W.CustomThemes)
		end
		if type(saved) ~= "table" or type(saved.CustomThemes) ~= "table" then
			return
		end
		for _, ct in ipairs(saved.CustomThemes) do
			if #W.CustomThemes >= MAX_CUSTOM_THEMES then
				break
			end
			if type(ct) == "table" and type(ct.Name) == "string" and not Themes[ct.Name] then
				local c1, c2, c3 = TableToColor(ct.C1), TableToColor(ct.C2), TableToColor(ct.C3)
				if c1 and c2 and c3 then
					local theme = BuildDerivedTheme(ct.Name, c1, c2, c3, TableToColor(ct.Accent))
					table.insert(W.CustomThemes, theme)
					Themes[ct.Name] = theme
				end
			end
		end
	end

	local Saved = ReadConfig()
	local ShowChangelogOnStart = (Saved ~= nil) and (Changelog ~= nil) and (tostring(Saved.Version) ~= VERSION)

	LoadCustomThemes(Saved, false)

	-- valor inicial de uma flag: salvo no config (se o tipo bater) ou padrao
	local function ResolveFlag(flag, default)
		local sv = Saved and type(Saved.Flags) == "table" and Saved.Flags[flag]
		if sv ~= nil then
			local d = Decode(sv)
			if d ~= nil and typeof(d) == typeof(default) then
				if type(d) == "number" and Ranges[flag] then
					d = math.clamp(d, Ranges[flag][1], Ranges[flag][2])
				end
				return d
			end
		end
		return default
	end

	for k, d in pairs(Defaults) do
