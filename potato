	local function UpdateWatermark(animate)
		local wm = UI.Watermark
		if not wm then
			return
		end
		local f = W.Flags
		local parts = {TITLE}
		if f._WmFps then
			table.insert(parts, tostring(WmFps) .. " fps")
		end
		if f._WmPing then
			table.insert(parts, tostring(WmPing) .. " ms")
		end
		if f._WmUser then
			table.insert(parts, LocalPlayer.Name)
		end
		if f._WmTime then
			table.insert(parts, os.date("%H:%M"))
		end
		if W.WatermarkExtra then
			local ok, extra = pcall(W.WatermarkExtra)
			if ok and type(extra) == "string" and extra ~= "" then
				table.insert(parts, extra)
			end
		end
		local text = table.concat(parts, "  |  ")
		local hasLogo = f._WmLogo and LOGO ~= false

		wm.Visible = f._Watermark
		UI.WatermarkLogo.Visible = hasLogo
		UI.WatermarkText.Text = text

		local textX = hasLogo and 30 or 10
		UI.WatermarkText.Position = UDim2.new(0, textX, 0, 0)
		UI.WatermarkText.Size = UDim2.new(1, -(textX + 8), 1, 0)

		local width = textX + math.ceil(MeasureText(text, 11, Enum.Font.Montserrat)) + 12
		local size = UDim2.new(0, width, 0, 26)
		if animate then
			Tween(wm, FastTween, {Size = size})
		else
			wm.Size = size
		end
	end

	function W:SetWatermark(t)
		local map = {
			Enabled = "_Watermark", Logo = "_WmLogo", Fps = "_WmFps",
			Ping = "_WmPing", User = "_WmUser", Time = "_WmTime"
		}
		for k, flag in pairs(map) do
			if type(t) == "table" and t[k] ~= nil then
				local el = W.Elements[flag]
				if el then
					el:Set(t[k] and true or false, true)
				else
					W.Flags[flag] = t[k] and true or false
				end
			end
		end
		UpdateWatermark(true)
		MarkDirty()
	end

