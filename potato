local function BuildDerivedTheme(name, c1, c2, c3, accent)
	local white = Color3.new(1, 1, 1)
	local avgBg = LerpColor(LerpColor(c1, c2, 0.5), c3, 0.35)
	local card1 = LerpColor(c1, white, 0.04)
	local card2 = LerpColor(c2, white, 0.03)
	local card3 = LerpColor(c3, white, 0.02)
	local cardBase = LerpColor(avgBg, white, 0.035)
	local cardHov = LerpColor(cardBase, white, 0.035)
	local ctrl = LerpColor(cardBase, white, 0.03)
	local ctrlHov = LerpColor(ctrl, white, 0.04)
	local border = LerpColor(cardBase, white, 0.09)
	local borderFocus = LerpColor(border, white, 0.12)
	return {
		Name = name,
		C1 = c1, C2 = c2, C3 = c3,
		Background = avgBg,
		Card = cardBase,
		CardHover = cardHov,
		Control = ctrl,
		ControlHov = ctrlHov,
		Border = border,
		BorderFocus = borderFocus,
		Accent = accent or Color3.fromRGB(255, 255, 255),
		Gradient = Make3ColorSequence(c1, c2, c3),
		CardGrad = Make3ColorSequence(card1, card2, card3)
	}
end

local function RGB(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function BuiltIn(name, d)
	return {
		Name = name,
		C1 = RGB(d.c1), C2 = RGB(d.c2), C3 = RGB(d.c3),
		Background = RGB(d.bg),
		Card = RGB(d.card),
		CardHover = RGB(d.cardH),
		Control = RGB(d.ctl),
		ControlHov = RGB(d.ctlH),
		Border = RGB(d.border),
		BorderFocus = RGB(d.focus),
		Accent = RGB(d.accent),
		Gradient = Make3ColorSequence(RGB(d.g[1]), RGB(d.g[2]), RGB(d.g[3])),
		CardGrad = Make3ColorSequence(RGB(d.k[1]), RGB(d.k[2]), RGB(d.k[3]))
	}
end

