	----------------------------------------------------------------------
	-- LAYOUT SALVO
	----------------------------------------------------------------------
	local function ApplyTabOrder(order)
		local list, used = {}, {}
		if type(order) == "table" then
			for _, n in ipairs(order) do
				if UI.Tabs[n] and not used[n] then
					table.insert(list, n)
					used[n] = true
				end
			end
		end
		for _, n in ipairs(UI.DefaultTabOrder) do
			if UI.Tabs[n] and not used[n] then
				table.insert(list, n)
			end
		end
		UI.TabOrder = list
		UpdateTabPositions(false, nil)
	end

	local function ApplyItemOrder(tabObj, order)
		if type(order) ~= "table" then
			return
		end
		local byId = {}
		for _, it in ipairs(tabObj.Items) do
			byId[it.Id] = it
		end
		local newList, used = {}, {}
		for _, id in ipairs(order) do
			local it = byId[id]
			if it and not used[it] then
				table.insert(newList, it)
				used[it] = true
			end
		end
		for _, it in ipairs(tabObj.Items) do
			if not used[it] then
				table.insert(newList, it)
			end
		end
		table.clear(tabObj.Items)
		for _, it in ipairs(newList) do
			table.insert(tabObj.Items, it)
		end
		RecalculateCardLayout(tabObj, tabObj.SearchBox.Text, false)
	end

	local function ApplyLayoutData(data)
		if type(data) ~= "table" then
			return
		end
		ApplyTabOrder(data.TabOrder)
		for name, tObj in pairs(UI.Tabs) do
			if type(data.TabColors) == "table" then
				local tc = TableToColor(data.TabColors[name])
				if tc then
					tObj.TabColor = tc
				end
			end
			if type(data.ContentColors) == "table" then
				local cc = TableToColor(data.ContentColors[name])
				if cc then
					tObj.ApplyContentAccent(cc)
				end
			end
			if type(data.ItemOrder) == "table" then
				ApplyItemOrder(tObj, data.ItemOrder[name])
			end
			if tObj.Panel and type(data.PanelSides) == "table" then
				local sv = data.PanelSides[name]
				if sv == "left" or sv == "right" then
					tObj.Panel.Side = sv
				end
			end
		end
		if type(data.WatermarkPos) == "table" and #data.WatermarkPos == 4 then
			local p = data.WatermarkPos
			if type(p[1]) == "number" and type(p[2]) == "number" and type(p[3]) == "number" and type(p[4]) == "number" then
				UI.Watermark.Position = UDim2.new(p[1], p[2], p[3], p[4])
			end
		end
		SwitchTab(UI.ActiveTab or UI.TabOrder[1])
	end

	local function BuildConfigData()
		local data = {
			Version = VERSION,
			Flags = {},
			CustomThemes = {},
			TabOrder = {},
			TabColors = {},
			ContentColors = {},
			ItemOrder = {},
			PanelSides = {}
		}
		for k, v in pairs(W.Flags) do
			data.Flags[k] = Encode(v)
		end
		for _, ct in ipairs(W.CustomThemes) do
			table.insert(data.CustomThemes, {
				Name = ct.Name,
				C1 = ColorToTable(ct.C1), C2 = ColorToTable(ct.C2), C3 = ColorToTable(ct.C3),
				Accent = ColorToTable(ct.Accent)
			})
		end
		for _, name in ipairs(UI.TabOrder) do
			table.insert(data.TabOrder, name)
			local tObj = UI.Tabs[name]
			if tObj then
				data.TabColors[name] = ColorToTable(tObj.TabColor)
				data.ContentColors[name] = ColorToTable(tObj.ContentColor)
				local ids = {}
				for _, it in ipairs(tObj.Items) do
					table.insert(ids, it.Id)
				end
				data.ItemOrder[name] = ids
				if tObj.Panel then
					data.PanelSides[name] = tObj.Panel.Side
				end
			end
		end
		local wm = UI.Watermark
		if wm then
			data.WatermarkPos = {wm.Position.X.Scale, wm.Position.X.Offset, wm.Position.Y.Scale, wm.Position.Y.Offset}
		end
		return data
	end

	SaveConfig = function()
		return WriteConfig(BuildConfigData())
	end

	function W:SaveConfig()
		return SaveConfig()
	end

	function W:LoadConfig()
		local data = ReadConfig()
		if not data then
			return false
		end
		Saved = data
		LoadCustomThemes(data, true)

		-- flags internas sem elemento + elementos (dispara callbacks)
		for flag, default in pairs(Defaults) do
			local v = ResolveFlag(flag, default)
			if W.Elements[flag] then
				W.Elements[flag]:Set(v, true)
			else
				W.Flags[flag] = v
			end
		end
		if not Themes[W.Flags._Theme] then
			W.Flags._Theme = "Pitch Black"
		end
		for flag, el in pairs(W.Elements) do
			if Defaults[flag] == nil and el.Set and el.Default ~= nil then
				local v = ResolveFlag(flag, el.Default)
				el:Set(v)
			end
		end

		ApplyTheme(W.Flags._Theme, false)
		if UI.RebuildThemeButtons then
			UI.RebuildThemeButtons()
		end
		ApplyLayoutData(data)
		ApplyPanelLayout(true)
		ApplyWindowSettings(true)
		return true
	end

	function W:ResetSettings()
		for flag, el in pairs(W.Elements) do
			if el.Default ~= nil and el.Set then
				el:Set(el.Default)
			end
		end
		for flag, default in pairs(Defaults) do
			if not W.Elements[flag] then
				W.Flags[flag] = default
			end
		end
		ApplyTheme(Defaults._Theme, true)
		if UI.RebuildThemeButtons then
			UI.RebuildThemeButtons()
		end
		ApplyWindowSettings(true)
		MarkDirty()
	end

	function W:ResetLayout()
		ApplyTabOrder(UI.DefaultTabOrder)
		for _, name in ipairs(UI.DefaultTabOrder) do
			local tObj = UI.Tabs[name]
			if tObj then
				ApplyItemOrder(tObj, tObj.DefaultOrder)
				tObj.TabColor = Theme.Accent
				tObj.ApplyContentAccent(Theme.Accent)
				if tObj.Panel then
					tObj.Panel.Side = tObj.Panel.DefaultSide or "right"
				end
			end
		end
		UI.Watermark.Position = UDim2.new(1, -18, 1, -42)
		ApplyPanelLayout(true)
		SwitchTab(UI.ActiveTab or UI.TabOrder[1])
		MarkDirty()
	end

