function Library:RegisterIcon(name, asset)
	if type(asset) == "number" then
		asset = "rbxassetid://" .. tostring(asset)
	end
	DirectAssets[name] = asset
end

local function ApplyIcon(img, iconName)
	if type(iconName) == "number" then
		iconName = "rbxassetid://" .. tostring(iconName)
	end
	if type(iconName) == "string" and string.sub(iconName, 1, 3) == "rbx" then
		img.Image = iconName
		img.ImageRectSize = Vector2.zero
		img.ImageRectOffset = Vector2.zero
		return
	end
	local entry = LucideIconsData and LucideIconsData[iconName]
	if entry and type(entry) == "table" and entry[1] then
		img.Image = "rbxassetid://" .. tostring(entry[1])
		if type(entry[2]) == "table" and type(entry[3]) == "table" then
			img.ImageRectSize = Vector2.new(entry[2][1] or 0, entry[2][2] or 0)
			img.ImageRectOffset = Vector2.new(entry[3][1] or 0, entry[3][2] or 0)
		end
	else
		img.Image = DirectAssets[iconName] or DirectAssets["sliders"]
		img.ImageRectSize = Vector2.zero
		img.ImageRectOffset = Vector2.zero
	end
end

local function CreateIcon(parent, iconName, sizePx, pos, color, zIndex)
	local img = Instance.new("ImageLabel")
	img.Name = "Icon"
	img.BackgroundTransparency = 1
	img.Size = UDim2.new(0, sizePx, 0, sizePx)
	img.Position = pos or UDim2.new(0, 0, 0, 0)
	img.ImageColor3 = color or Color3.fromRGB(200, 200, 205)
	img.ScaleType = Enum.ScaleType.Fit
	img.ZIndex = zIndex or 2
	ApplyIcon(img, iconName)
	img.Parent = parent
	return img
end

----------------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------------
local function LerpColor(c1, c2, alpha)
	return Color3.new(
		c1.R + (c2.R - c1.R) * alpha,
		c1.G + (c2.G - c1.G) * alpha,
		c1.B + (c2.B - c1.B) * alpha
	)
end

local function Make3ColorSequence(c1, c2, c3)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, c1),
		ColorSequenceKeypoint.new(0.5, c2),
		ColorSequenceKeypoint.new(1, c3)
	})
end

local function BoostSequence(seq, factor)
	local pts = {}
	for _, kp in ipairs(seq.Keypoints) do
		local c = kp.Value
		table.insert(pts, ColorSequenceKeypoint.new(kp.Time, Color3.new(
			math.min(c.R * factor, 1),
			math.min(c.G * factor, 1),
			math.min(c.B * factor, 1)
		)))
	end
	return ColorSequence.new(pts)
end

local function ColorToTable(c)
	return {
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5)
	}
end

local function TableToColor(t)
	if type(t) == "table" and type(t[1]) == "number" and type(t[2]) == "number" and type(t[3]) == "number" then
		return Color3.fromRGB(
			math.clamp(math.floor(t[1]), 0, 255),
			math.clamp(math.floor(t[2]), 0, 255),
			math.clamp(math.floor(t[3]), 0, 255)
		)
	end
	return nil
end

local function MeasureText(text, size, font)
	local ok, vec = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(1000, 100))
	end)
	if ok and vec then
		return vec.X
	end
	return #text * (size * 0.6)
end

-- serializacao dos valores das flags (Color3 / KeyCode viram tabelas marcadas)
local function Encode(v)
	local t = typeof(v)
	if t == "Color3" then
		return {__c = ColorToTable(v)}
	elseif t == "EnumItem" then
		return {__k = v.Name}
	elseif type(v) == "table" then
		local out = {}
		for k, x in pairs(v) do
			out[k] = Encode(x)
		end
		return out
	end
	return v
end

local function Decode(v)
	if type(v) == "table" then
		if v.__c then
			return TableToColor(v.__c)
		end
		if v.__k then
			local ok, kc = pcall(function()
				return Enum.KeyCode[v.__k]
			end)
			if ok and kc then
				return kc
			end
			return nil
		end
		local out = {}
		for k, x in pairs(v) do
			out[k] = Decode(x)
		end
		return out
	end
	return v
end

