	-- SLIDER
	local function AddSlider(tabObj, o)
		local title = o.Name or "Slider"
		local minVal, maxVal = o.Min or 0, o.Max or 100
		local inc = o.Increment or 1
		local suffix = o.Suffix or ""
		local card = CreateCard(tabObj, 54, title, o.Icon, o.Flag or title)

		MakeLabel(card, title, UDim2.new(0.65, 0, 0, 18), UDim2.new(0, 36, 0, 7), Enum.Font.MontserratBold, 12, Theme.TextPrimary)
		local valLbl = MakeLabel(card, "", UDim2.new(0.3, -14, 0, 18), UDim2.new(0.7, 0, 0, 7), Enum.Font.Montserrat, 11, Theme.TextSub)
		valLbl.TextXAlignment = Enum.TextXAlignment.Right

		local track = Instance.new("Frame")
		track.Size = UDim2.new(1, -50, 0, 5)
		track.Position = UDim2.new(0, 36, 0, 35)
		track.BorderSizePixel = 0
		track.Parent = card
		RegisterTrans(track, "BackgroundTransparency", 0)
		RegisterSurface(track, "Control", false)

		local fill = Instance.new("Frame")
		fill.BackgroundColor3 = tabObj.ContentColor
		fill.BorderSizePixel = 0
		fill.Parent = track
		table.insert(tabObj.AccentTargets, {Obj = fill, Prop = "BackgroundColor3"})

		local thumb = Instance.new("Frame")
		thumb.Size = UDim2.new(0, 8, 0, 14)
		thumb.BackgroundColor3 = Theme.TextPrimary
		thumb.BorderSizePixel = 0
		thumb.Parent = track

		local thumbStroke = Instance.new("UIStroke")
		thumbStroke.Color = Theme.Background
		thumbStroke.Thickness = 1
		thumbStroke.Parent = thumb
		RegStroke(thumbStroke, "Background")

		local function Snap(val)
			val = math.floor(val / inc + 0.5) * inc
			val = math.clamp(val, minVal, maxVal)
			return math.floor(val * 1000 + 0.5) / 1000
		end

		local default = Snap(o.Default or minVal)
		local el = NewElement(o, "Slider", default)
		el.Value = Snap(el.Value)

		local function Visual(val)
			local ratio = math.clamp((val - minVal) / math.max(maxVal - minVal, 1e-9), 0, 1)
			fill.Size = UDim2.new(ratio, 0, 1, 0)
			thumb.Position = UDim2.new(ratio, -4, 0.5, -7)
			valLbl.Text = tostring(val) .. suffix
		end
		Visual(el.Value)

		function el:Set(v, silent)
			v = Snap(tonumber(v) or default)
			Visual(v)
			Commit(self, v, silent)
		end

		local dragging = false
		local function fromInput(input)
			local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			local v = Snap(minVal + (maxVal - minVal) * pos)
			if v ~= el.Value then
				el:Set(v)
			end
		end
		local function begin(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and not UI.TabEditMode then
				dragging = true
				fromInput(input)
			end
		end
		track.InputBegan:Connect(begin)
		thumb.InputBegan:Connect(begin)
		Connect(UserInputService.InputChanged, function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				fromInput(input)
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end)

		el.Card = card
		FireOnInit(el, o)
		return el
	end

	-- CORES (swatches)
	local function AddColors(tabObj, o)
		local title = o.Name or "Color"
		local swatches = o.Options or TabColorSwatches
		local card = CreateCard(tabObj, 48, title, o.Icon or "palette", o.Flag or title)
		local lbl = MakeLabel(card, title, UDim2.new(0.45, 0, 1, 0), UDim2.new(0, 36, 0, 0), Enum.Font.MontserratBold, 12, Theme.TextPrimary)

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(0, #swatches * 22, 0, 20)
		holder.Position = UDim2.new(1, -(#swatches * 22 + 12), 0.5, -10)
		holder.BackgroundTransparency = 1
		holder.Parent = card

		local default = o.Default or swatches[1]
		local el = NewElement(o, "Colors", default)
		local entries = {}

		local function Highlight(col)
			for _, e in ipairs(entries) do
				local sel = (e.Col == col)
				e.Stroke.Color = sel and Theme.TextPrimary or Theme.Border
				e.Stroke.Thickness = sel and 1.6 or 1
			end
		end

		for i, col in ipairs(swatches) do
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(0, 16, 0, 16)
			b.Position = UDim2.new(0, (i - 1) * 22, 0.5, -8)
			b.BackgroundColor3 = col
			b.Text = ""
			b.AutoButtonColor = false
			b.Parent = holder

			local bc = Instance.new("UICorner")
			bc.CornerRadius = UDim.new(1, 0)
			bc.Parent = b

			local bs = Instance.new("UIStroke")
			bs.Color = Theme.Border
			bs.Thickness = 1
			bs.Parent = b
			table.insert(entries, {Col = col, Stroke = bs})

			b.MouseButton1Click:Connect(function()
				if UI.TabEditMode then
					return
				end
				el:Set(col)
			end)
		end

		function el:Set(col, silent)
			if typeof(col) ~= "Color3" then
				return
			end
			Highlight(col)
			Commit(self, col, silent)
		end

		Highlight(el.Value)
		el.Card = card
		el.Label = lbl
		FireOnInit(el, o)
		return el
	end

