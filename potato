					if input.Position.X > mainCenter + 30 and panel.Side == "left" then
						panel.Side = "right"
						moved = true
						ApplyPanelLayout(true)
						MarkDirty()
					elseif input.Position.X < mainCenter - 30 and panel.Side == "right" then
						panel.Side = "left"
						moved = true
						ApplyPanelLayout(true)
						MarkDirty()
					end
				end
			end)
			Connect(UserInputService.InputEnded, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
					dragging = false
					if not moved then
						panel.Side = (panel.Side == "left") and "right" or "left"
						ApplyPanelLayout(true)
						MarkDirty()
					end
