		local function MakeChip(themeObj, x, y, hasActions)
			local selected = (W.Flags._Theme == themeObj.Name)

			local chip = Instance.new("Frame")
			chip.Size = UDim2.new(0.32, 0, 0, 22)
			chip.Position = UDim2.new(x, 0, 0, y)
