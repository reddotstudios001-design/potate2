		local function CloseStudio()
			Tween(Overlay, FastTween, {BackgroundTransparency = 1})
			task.delay(0.15, function()
				Overlay.Visible = false
			end)
		end
		tsCloseBtn.MouseButton1Click:Connect(CloseStudio)
		CancelBtn.MouseButton1Click:Connect(CloseStudio)

		OpenStudioImpl = function(editIndex)
			EditingIndex = editIndex
			if editIndex and W.CustomThemes[editIndex] then
				local ct = W.CustomThemes[editIndex]
				NameBox.Text = ct.Name
				StopColors[1], StopColors[2], StopColors[3] = ct.C1, ct.C2, ct.C3
			else
				NameBox.Text = "Custom " .. tostring(#W.CustomThemes + 1)
				StopColors[1] = Color3.fromRGB(24, 18, 42)
				StopColors[2] = Color3.fromRGB(14, 11, 24)
				StopColors[3] = Color3.fromRGB(7, 6, 12)
			end
			LoadStop(1)
			Overlay.Visible = true
			Tween(Overlay, FastTween, {BackgroundTransparency = 0.45})
		end

		SaveBtn.MouseButton1Click:Connect(function()
			local rawName = NameBox.Text:gsub("^%s*(.-)%s*$", "%1")
			rawName = string.sub(rawName, 1, 18)
			if rawName == "" then
				rawName = "Custom " .. tostring(EditingIndex or (#W.CustomThemes + 1))
			end
			if Themes[rawName] and (not EditingIndex or W.CustomThemes[EditingIndex].Name ~= rawName) then
				rawName = rawName .. " #" .. tostring(EditingIndex or (#W.CustomThemes + 1))
			end

			local accentCol = LerpColor(StopColors[1], Color3.new(1, 1, 1), 0.65)
			local newTheme = BuildDerivedTheme(rawName, StopColors[1], StopColors[2], StopColors[3], accentCol)

			if EditingIndex and W.CustomThemes[EditingIndex] then
				Themes[W.CustomThemes[EditingIndex].Name] = nil
				W.CustomThemes[EditingIndex] = newTheme
				Themes[rawName] = newTheme
			else
				if #W.CustomThemes >= MAX_CUSTOM_THEMES then
					CloseStudio()
					return
				end
				table.insert(W.CustomThemes, newTheme)
				Themes[rawName] = newTheme
			end

			if W.Elements._Gradient then
				W.Elements._Gradient:Set(true, true)
			else
				W.Flags._Gradient = true
			end
			ApplyTheme(rawName, true)
			if UI.RebuildThemeButtons then
				UI.RebuildThemeButtons()
			end
			CloseStudio()
			MarkDirty()
		end)
	end

	local function OpenThemeStudio(idx)
		if not ThemeStudioBuilt then
			BuildThemeStudio()
		end
		OpenStudioImpl(idx)
	end

