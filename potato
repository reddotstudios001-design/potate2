	----------------------------------------------------------------------
	-- CHANGELOG
	----------------------------------------------------------------------
	local ChangelogScale = nil
	if Changelog then
		local ChangelogFrame = Instance.new("Frame")
		ChangelogFrame.Name = "ChangelogFrame"
		ChangelogFrame.Size = UDim2.new(0, 420, 0, 290)
		ChangelogFrame.Position = UDim2.new(0.5, -210, 0.5, -145)
		ChangelogFrame.BorderSizePixel = 0
		ChangelogFrame.Visible = false
		ChangelogFrame.ClipsDescendants = true
		ChangelogFrame.ZIndex = 25
		ChangelogFrame.Parent = ScreenGui
		RegisterTrans(ChangelogFrame, "BackgroundTransparency", 0)
		RegisterSurface(ChangelogFrame, "Bg", true)
		UI.ChangelogFrame = ChangelogFrame

		ChangelogScale = Instance.new("UIScale")
		ChangelogScale.Scale = 0.9
		ChangelogScale.Parent = ChangelogFrame
		UI.ChangelogScale = ChangelogScale

		local clCorner = Instance.new("UICorner")
		clCorner.CornerRadius = UDim.new(0, 8)
		clCorner.Parent = ChangelogFrame

		local clStroke = Instance.new("UIStroke")
		clStroke.Color = Theme.Border
		clStroke.Thickness = 1
		clStroke.Parent = ChangelogFrame
		RegisterTrans(clStroke, "Transparency", 0)
		RegStroke(clStroke)

		local clHeader = Instance.new("Frame")
		clHeader.Size = UDim2.new(1, 0, 0, 42)
		clHeader.BackgroundTransparency = 1
		clHeader.Parent = ChangelogFrame

		CreateIcon(clHeader, "sparkles", 15, UDim2.new(0, 14, 0.5, -7), Theme.TextPrimary, 26)

		local clTitle = MakeLabel(clHeader, TITLE .. " " .. VERSION .. "  —  what's new", UDim2.new(1, -80, 1, 0), UDim2.new(0, 36, 0, 0),
			Enum.Font.MontserratBold, 13, Theme.TextPrimary)
		clTitle.ZIndex = 26

		local clCloseBtn = Instance.new("TextButton")
		clCloseBtn.Size = UDim2.new(0, 26, 0, 26)
		clCloseBtn.Position = UDim2.new(1, -36, 0.5, -13)
		clCloseBtn.Text = ""
		clCloseBtn.BackgroundTransparency = 1
		clCloseBtn.AutoButtonColor = false
		clCloseBtn.ZIndex = 26
		clCloseBtn.Parent = clHeader

		local clCloseIcon = CreateIcon(clCloseBtn, "x", 12, UDim2.new(0.5, -6, 0.5, -6), Theme.TextSub, 27)
		clCloseBtn.MouseEnter:Connect(function()
			Tween(clCloseIcon, FastTween, {ImageColor3 = Theme.Danger, Rotation = 90})
		end)
		clCloseBtn.MouseLeave:Connect(function()
			Tween(clCloseIcon, FastTween, {ImageColor3 = Theme.TextSub, Rotation = 0})
		end)

		local clDiv = Instance.new("Frame")
		clDiv.Size = UDim2.new(1, 0, 0, 1)
		clDiv.Position = UDim2.new(0, 0, 0, 42)
		clDiv.BackgroundColor3 = Theme.Border
		clDiv.BorderSizePixel = 0
		clDiv.Parent = ChangelogFrame
		RegisterTrans(clDiv, "BackgroundTransparency", 0)
		RegDivider(clDiv)

		local clScroll = Instance.new("ScrollingFrame")
		clScroll.Size = UDim2.new(1, -28, 1, -56)
		clScroll.Position = UDim2.new(0, 14, 0, 48)
		clScroll.BackgroundTransparency = 1
		clScroll.BorderSizePixel = 0
		clScroll.ScrollBarThickness = 2
		clScroll.ScrollBarImageColor3 = Theme.BorderFocus
		clScroll.Parent = ChangelogFrame

		local cy = 3
		for _, entry in ipairs(Changelog) do
			local head, desc = tostring(entry[1] or ""), tostring(entry[2] or "")
			local descH = 28
			local ok, sz = pcall(function()
				return TextService:GetTextSize(desc, 10, Enum.Font.Montserrat, Vector2.new(342, 1000))
			end)
			if ok and sz then
				descH = math.ceil(sz.Y)
			end
			local boxH = 28 + descH + 8

			local box = Instance.new("Frame")
			box.Size = UDim2.new(1, -10, 0, boxH)
			box.Position = UDim2.new(0, 3, 0, cy)
			box.BorderSizePixel = 0
			box.Parent = clScroll
			RegisterTrans(box, "BackgroundTransparency", 0)
			RegisterSurface(box, "Card", true)

			local bc = Instance.new("UICorner")
			bc.CornerRadius = UDim.new(0, 6)
			bc.Parent = box

			local bs = Instance.new("UIStroke")
			bs.Color = Theme.Border
			bs.Thickness = 1
			bs.Parent = box
			RegisterTrans(bs, "Transparency", 0)
			RegStroke(bs)

			MakeLabel(box, head, UDim2.new(1, -20, 0, 18), UDim2.new(0, 10, 0, 6), Enum.Font.MontserratBold, 11, Theme.TextPrimary)
			local d = MakeLabel(box, desc, UDim2.new(1, -20, 0, descH), UDim2.new(0, 10, 0, 25), Enum.Font.Montserrat, 10, Theme.TextSub)
			d.TextWrapped = true
			d.TextTruncate = Enum.TextTruncate.None
			d.TextYAlignment = Enum.TextYAlignment.Top

			cy = cy + boxH + 6
		end
		clScroll.CanvasSize = UDim2.new(0, 0, 0, cy + 6)

		function W:ShowChangelog()
			UI.ChangelogOpen = true
			MainFrame.Visible = false
			ChangelogFrame.Visible = true
			ChangelogScale.Scale = 0.88 * (W.Flags._Scale / 100)
			Tween(ChangelogScale, PopInTween, {Scale = W.Flags._Scale / 100})
		end

		function W:HideChangelog()
			UI.ChangelogOpen = false
			Tween(ChangelogScale, FastTween, {Scale = 0.88 * (W.Flags._Scale / 100)})
			task.delay(0.15, function()
				if UI.ChangelogOpen then
					return
				end
				ChangelogFrame.Visible = false
				if not UI.IsHidden then
					MainFrame.Visible = true
					MainScale.Scale = 0.92 * (W.Flags._Scale / 100)
					Tween(MainScale, PopInTween, {Scale = W.Flags._Scale / 100})
				end
			end)
		end

		UI.VersionBtn.MouseButton1Click:Connect(function()
			W:ShowChangelog()
		end)
		clCloseBtn.MouseButton1Click:Connect(function()
			W:HideChangelog()
		end)
	else
		function W:ShowChangelog() end
		function W:HideChangelog() end
	end

	----------------------------------------------------------------------
	-- MINIMIZAR / FECHAR / ARRASTAR / TOGGLE
	----------------------------------------------------------------------
	local Unloaded = false

	function W:Unload()
		if Unloaded then
			return
		end
		Unloaded = true
		pcall(SaveConfig)
		UI.Ready = false
		for _, c in ipairs(Connections) do
			pcall(function()
				c:Disconnect()
			end)
		end
		table.clear(Connections)
		if opts.OnUnload then
			pcall(opts.OnUnload)
		end
		for _, el in pairs(W.Elements) do
			el.Callback = nil
		end
		ScreenGui:Destroy()
		if Env and Env.__PotatoLibUnload == W.Unload then
			Env.__PotatoLibUnload = nil
		end
	end
	if Env then
		Env.__PotatoLibUnload = function()
			W:Unload()
		end
	end

	local function SetMinimized(minimized)
		UI.IsMinimized = minimized
		if minimized then
			UI.TabContainer.Visible = false
			BodyFrame.Visible = false
			UI.FooterBar.Visible = false
			UI.TopDivider.Visible = false
			ApplyIcon(UI.MinIcon, "maximize-2")
			Tween(MainFrame, SmoothTween, {Size = UDim2.new(0, MIN_W, 0, MIN_H)})
		else
			ApplyIcon(UI.MinIcon, "minus")
			Tween(MainFrame, SmoothTween, {Size = UDim2.new(0, EXPANDED_W, 0, EXPANDED_H)})
			task.delay(0.14, function()
				if not UI.IsMinimized then
					UI.TabContainer.Visible = true
					BodyFrame.Visible = true
					UI.FooterBar.Visible = true
					UI.TopDivider.Visible = true
				end
			end)
		end
	end
	function W:SetMinimized(v)
		SetMinimized(v and true or false)
	end

	UI.MinBtn.MouseButton1Click:Connect(function()
		SetMinimized(not UI.IsMinimized)
	end)

	UI.CloseBtn.MouseButton1Click:Connect(function()
		if UI.IsMinimized then
			SetMinimized(false)
			task.wait(0.2)
		end
		UI.ModalOverlay.Visible = true
		Tween(UI.ModalOverlay, FastTween, {BackgroundTransparency = 0.45})
	end)

	UI.CancelBtn.MouseButton1Click:Connect(function()
		Tween(UI.ModalOverlay, FastTween, {BackgroundTransparency = 1})
		task.delay(0.16, function()
			UI.ModalOverlay.Visible = false
		end)
	end)

	UI.ConfirmBtn.MouseButton1Click:Connect(function()
		W:Unload()
	end)

	function W:SetVisible(visible)
		visible = visible and true or false
		if visible == (not UI.IsHidden) then
			return
		end
		UI.IsHidden = not visible
		local target = UI.ChangelogOpen and UI.ChangelogFrame or MainFrame
		local scaleObj = UI.ChangelogOpen and ChangelogScale or MainScale
		local base = W.Flags._Scale / 100
		if UI.IsHidden then
			Tween(scaleObj, FastTween, {Scale = 0.88 * base})
			task.delay(0.15, function()
				if UI.IsHidden then
					target.Visible = false
				end
			end)
		else
			target.Visible = true
			scaleObj.Scale = 0.88 * base
			Tween(scaleObj, PopInTween, {Scale = base})
		end
	end

	function W:Toggle()
		W:SetVisible(UI.IsHidden)
	end

	function W:SetTheme(themeName)
		if Themes[themeName] then
			ApplyTheme(themeName, true)
			if UI.RebuildThemeButtons then
				UI.RebuildThemeButtons()
			end
		end
	end

	function W:SetAccent(col)
		ApplyGlobalAccent(col)
	end

	do
		local dragging = false
		local dragStart = Vector2.zero
		local startPos = UDim2.new()

		UI.TopBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				dragStart = Vector2.new(input.Position.X, input.Position.Y)
				startPos = MainFrame.Position
			end
		end)
		Connect(UserInputService.InputChanged, function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
				MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end)

		Connect(UserInputService.InputBegan, function(input, gp)
			if gp or UI.BindingKey or UI.JustBound then
				return
			end
			if input.KeyCode == W.Flags._ToggleKey then
				W:Toggle()
			end
		end)
	end

	-- contador de FPS / ping para a watermark
	do
		local fpsCounter, lastFps = 0, tick()
		Connect(RunService.RenderStepped, function()
			if not ScreenGui.Parent then
				return
			end
			fpsCounter = fpsCounter + 1
			local now = tick()
			if now - lastFps >= 1 then
				WmFps = fpsCounter
				fpsCounter = 0
				lastFps = now
				if W.Flags._WmPing then
					pcall(function()
						WmPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
					end)
				end
				if W.Flags._Watermark then
					UpdateWatermark(false)
				end
			end
		end)
	end

	----------------------------------------------------------------------
	-- INIT
	----------------------------------------------------------------------
	function W:Init()
		if W.Initialized then
			return W
		end
		W.Initialized = true

		-- ordem padrao (antes de aplicar o layout salvo)
		for _, tObj in pairs(UI.Tabs) do
			table.clear(tObj.DefaultOrder)
			for _, it in ipairs(tObj.Items) do
				table.insert(tObj.DefaultOrder, it.Id)
			end
			if tObj.Panel then
				tObj.Panel.DefaultSide = tObj.Panel.DefaultSide or "right"
			end
		end

		ApplyLayoutData(Saved)
		SwitchTab(UI.ActiveTab or UI.TabOrder[1])

		ApplyTheme(W.Flags._Theme, false)
		if UI.RebuildThemeButtons then
			UI.RebuildThemeButtons()
		end
		ApplyPanelLayout(false)
		ApplyWindowSettings(false)

		UI.Ready = true
		SaveConfig()

		if ShowChangelogOnStart then
			MainScale.Scale = W.Flags._Scale / 100
			W:ShowChangelog()
		else
			MainScale.Scale = 0.88 * (W.Flags._Scale / 100)
			Tween(MainScale, PopInTween, {Scale = W.Flags._Scale / 100})
		end
		return W
	end

	-- fallback: se o script esquecer de chamar Window:Init(), inicia sozinho
	task.delay(3, function()
		if not W.Initialized and not Unloaded then
			W:Init()
		end
	end)

	table.insert(Library, W)
	return W
end

return Library
