	----------------------------------------------------------------------
	-- ELEMENTOS
	----------------------------------------------------------------------
	local function Fire(el, v)
		if el.Callback then
			local ok, err = pcall(el.Callback, v)
			if not ok then
				warn("[" .. TITLE .. "] erro no callback: " .. tostring(err))
			end
		end
		for _, f in ipairs(el.Listeners) do
			pcall(f, v)
		end
	end

	local function NewElement(o, kind, default)
		local el = {Kind = kind, Flag = o.Flag, Default = default, Callback = o.Callback, Listeners = {}, Value = default}
		if o.Flag then
			el.Value = ResolveFlag(o.Flag, default)
			W.Flags[o.Flag] = el.Value
			W.Elements[o.Flag] = el
		end
		function el:OnChanged(fn)
			table.insert(self.Listeners, fn)
		end
		function el:Get()
			return self.Value
		end
		return el
	end

	local function Commit(el, v, silent)
		el.Value = v
		if el.Flag then
			W.Flags[el.Flag] = v
		end
		if not silent then
			Fire(el, v)
		end
		MarkDirty()
	end

	local function FireOnInit(el, o)
		if o.FireOnInit or el.Value ~= el.Default then
			task.defer(Fire, el, el.Value)
		end
	end

