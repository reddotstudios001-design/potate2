			chip.Parent = gridHolder

			local cc = Instance.new("UICorner")
			cc.CornerRadius = UDim.new(0, 5)
			cc.Parent = chip

			-- gradiente no Frame (nao no texto): UIGradient em TextButton tinge o texto
			local cg = Instance.new("UIGradient")
			cg.Color = ThemePreviewSeq(themeObj)
			cg.Rotation = 20
			cg.Parent = chip

			local cs = Instance.new("UIStroke")
			cs.Color = selected and themeObj.Accent or themeObj.BorderFocus
			cs.Thickness = selected and 1.6 or 1
			cs.Parent = chip

			local dot = Instance.new("Frame")
			dot.Size = UDim2.new(0, 8, 0, 8)
			dot.Position = UDim2.new(0, 7, 0.5, -4)
			dot.BackgroundColor3 = themeObj.Accent
			dot.BorderSizePixel = 0
			dot.ZIndex = 2
			dot.Parent = chip
			local dc = Instance.new("UICorner")
			dc.CornerRadius = UDim.new(1, 0)
			dc.Parent = dot

			local lbl = MakeLabel(chip, themeObj.Name, UDim2.new(1, -(20 + (hasActions and 38 or 6)), 1, 0), UDim2.new(0, 20, 0, 0),
				Enum.Font.MontserratBold, 10, selected and Color3.new(1, 1, 1) or Color3.fromRGB(205, 205, 212))
			lbl.ZIndex = 2

			local clickBtn = Instance.new("TextButton")
			clickBtn.Size = UDim2.new(1, hasActions and -38 or 0, 1, 0)
			clickBtn.BackgroundTransparency = 1
			clickBtn.Text = ""
			clickBtn.ZIndex = 3
			clickBtn.Parent = chip

			return chip, clickBtn
		end

		local function Render()
			for _, child in ipairs(gridHolder:GetChildren()) do
				child:Destroy()
			end
			ntLabel.Text = string.format("New Theme (%d/%d)", #W.CustomThemes, MAX_CUSTOM_THEMES)
			local full = #W.CustomThemes >= MAX_CUSTOM_THEMES
			ntLabel.TextColor3 = full and Theme.TextMuted or Theme.TextPrimary
			ntIcon.ImageColor3 = full and Theme.TextMuted or Theme.TextPrimary

			local perRow = 3
			for i, tName in ipairs(BuiltInThemeOrder) do
				local colIdx = (i - 1) % perRow
				local rowIdx = math.floor((i - 1) / perRow)
				local _, clickBtn = MakeChip(Themes[tName], colIdx * 0.34, rowIdx * 26, false)
				clickBtn.MouseButton1Click:Connect(function()
					if UI.TabEditMode then
						return
					end
					ApplyTheme(tName, true)
					Render()
				end)
			end

			local customRow = math.ceil(#BuiltInThemeOrder / perRow)
			for cIdx, cTheme in ipairs(W.CustomThemes) do
				local colIdx = (cIdx - 1) % perRow
				local chip, clickBtn = MakeChip(cTheme, colIdx * 0.34, customRow * 26, true)

				local editBtn = Instance.new("TextButton")
				editBtn.Size = UDim2.new(0, 16, 0, 16)
				editBtn.Position = UDim2.new(1, -36, 0.5, -8)
				editBtn.BackgroundTransparency = 1
				editBtn.Text = ""
				editBtn.ZIndex = 4
				editBtn.Parent = chip
				CreateIcon(editBtn, "edit", 11, UDim2.new(0.5, -5, 0.5, -5), Color3.fromRGB(235, 235, 240), 5)

				local delBtn = Instance.new("TextButton")
				delBtn.Size = UDim2.new(0, 16, 0, 16)
				delBtn.Position = UDim2.new(1, -19, 0.5, -8)
				delBtn.BackgroundTransparency = 1
				delBtn.Text = ""
				delBtn.ZIndex = 4
				delBtn.Parent = chip
				CreateIcon(delBtn, "trash", 11, UDim2.new(0.5, -5, 0.5, -5), Theme.Danger, 5)

				clickBtn.MouseButton1Click:Connect(function()
					if UI.TabEditMode then
						return
					end
					ApplyTheme(cTheme.Name, true)
					Render()
				end)
				editBtn.MouseButton1Click:Connect(function()
					if UI.TabEditMode then
						return
					end
					OpenThemeStudio(cIdx)
				end)
				delBtn.MouseButton1Click:Connect(function()
					if UI.TabEditMode then
						return
					end
					local removedName = cTheme.Name
					table.remove(W.CustomThemes, cIdx)
					Themes[removedName] = nil
					if W.Flags._Theme == removedName then
						ApplyTheme("Pitch Black", true)
					end
					Render()
					MarkDirty()
				end)
			end
		end

		UI.RebuildThemeButtons = Render
		Render()
		return {Card = card}
	end

