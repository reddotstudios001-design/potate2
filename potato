		MakeLabel(card, title, UDim2.new(0.6, 0, 1, 0), UDim2.new(0, 36, 0, 0), Enum.Font.MontserratBold, 12, Theme.TextPrimary)

		local default = o.Default or Enum.KeyCode.E
		local el = NewElement(o, "Keybind", default)

		local bindBtn = Instance.new("TextButton")
		bindBtn.Size = UDim2.new(0, 82, 0, 24)
		bindBtn.Position = UDim2.new(1, -94, 0.5, -12)
		bindBtn.Font = Enum.Font.MontserratBold
		bindBtn.Text = "[" .. el.Value.Name .. "]"
		bindBtn.TextSize = 11
		bindBtn.TextColor3 = Theme.TextPrimary
		bindBtn.AutoButtonColor = false
		bindBtn.Parent = card
		StyleControl(bindBtn, 5)

		function el:Set(kc, silent)
			if typeof(kc) ~= "EnumItem" then
				return
			end
			bindBtn.Text = "[" .. kc.Name .. "]"
			bindBtn.TextColor3 = Theme.TextPrimary
			Commit(self, kc, silent)
		end

		bindBtn.MouseButton1Click:Connect(function()
			if UI.TabEditMode then
				return
			end
			UI.BindingKey = true
			bindBtn.Text = "[ ... ]"
			bindBtn.TextColor3 = tabObj.ContentColor
		end)

		local mine = false
		bindBtn.MouseButton1Click:Connect(function()
			mine = true
		end)

		Connect(UserInputService.InputBegan, function(input, gp)
			if mine and UI.BindingKey and input.UserInputType == Enum.UserInputType.Keyboard then
				mine = false
				UI.BindingKey = false
				UI.JustBound = true
				task.delay(0.25, function()
					UI.JustBound = false
				end)
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Unknown then
					el:Set(el.Value, true)
				else
					el:Set(input.KeyCode)
				end
				return
			end
			if o.Pressed and not gp and not UI.BindingKey and not UI.JustBound and input.KeyCode == el.Value then
