		btn.AutoButtonColor = false
		btn.Text = tostring(el.Value)
		btn.Parent = card
		local surf = StyleControl(btn, 5)
		HoverSurface(btn, surf)

		function el:Set(v, silent)
			btn.Text = tostring(v)
			Commit(self, v, silent)
		end

		function el:SetOptions(list, keep)
			options = list or {}
			if not (keep and table.find(options, self.Value)) then
				self:Set(options[1] or "", true)
			end
		end

		local function Close()
			if DropdownList then
				DropdownList.Visible = false
				DropdownBlocker.Visible = false
			end
			if DropdownCloser == Close then
				DropdownCloser = nil
			end
		end

		btn.MouseButton1Click:Connect(function()
			if UI.TabEditMode then
				return
			end
			EnsureDropdownParts()
			if DropdownCloser then
				local wasMine = (DropdownCloser == Close)
				DropdownCloser()
				if wasMine then
					return
				end
			end
			for _, ch in ipairs(DropdownList:GetChildren()) do
				if ch:IsA("TextButton") then
					ch:Destroy()
				end
			end
			local rowH = 24
			for i, opt in ipairs(options) do
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1, -8, 0, rowH - 2)
				b.Position = UDim2.new(0, 4, 0, 3 + (i - 1) * rowH)
				b.BackgroundTransparency = 1
				b.Font = Enum.Font.MontserratBold
				b.TextSize = 10
				b.Text = tostring(opt)
				b.TextXAlignment = Enum.TextXAlignment.Left
				b.TextColor3 = (opt == el.Value) and tabObj.ContentColor or Theme.TextPrimary
				b.AutoButtonColor = false
				b.ZIndex = 41
				b.Parent = DropdownList
				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0, 8)
				pad.Parent = b
				local bc = Instance.new("UICorner")
				bc.CornerRadius = UDim.new(0, 4)
				bc.Parent = b
				b.MouseEnter:Connect(function()
					b.BackgroundTransparency = 0
					b.BackgroundColor3 = Theme.Control
				end)
				b.MouseLeave:Connect(function()
					b.BackgroundTransparency = 1
				end)
				b.MouseButton1Click:Connect(function()
					el:Set(opt)
					Close()
				end)
			end

			local s = MainScale.Scale
			local rel = btn.AbsolutePosition - MainFrame.AbsolutePosition
			local listH = math.min(#options, 7) * rowH + 6
			local x = rel.X / s
			local y = (rel.Y + btn.AbsoluteSize.Y) / s + 3
			local frameH = MainFrame.AbsoluteSize.Y / s
			if y + listH > frameH - 4 then
				y = rel.Y / s - listH - 3
			end
			DropdownList.Position = UDim2.new(0, x, 0, y)
			DropdownList.Size = UDim2.new(0, btn.AbsoluteSize.X / s, 0, listH)
			DropdownList.CanvasSize = UDim2.new(0, 0, 0, #options * rowH + 6)
			DropdownList.CanvasPosition = Vector2.zero
			DropdownBlocker.Visible = true
			DropdownList.Visible = true
			DropdownCloser = Close
		end)

		el.Card = card
		FireOnInit(el, o)
		return el
	end

	----------------------------------------------------------------------
	-- APPLY THEME
	----------------------------------------------------------------------
	local function ApplyTheme(themeName, applyAccent)
		local t = Themes[themeName]
		if not t then
			return
		end
		W.Flags._Theme = themeName
		SyncThemeTable(themeName)

		for _, s in ipairs(Surfaces) do
			RefreshSurface(s, true)
		end
		for _, st in ipairs(ThemedStrokes) do
			if st.Obj and st.Obj.Parent then
				Tween(st.Obj, FastTween, {Color = Theme[st.Key]})
			end
		end
		for _, div in ipairs(ThemedDividers) do
			if div and div.Parent then
				Tween(div, FastTween, {BackgroundColor3 = Theme.Border})
			end
		end
		if applyAccent and ApplyGlobalAccent then
			ApplyGlobalAccent(t.Accent)
		else
			for _, sw in ipairs(SwitchRegistry) do
				sw.Refresh(true)
			end
		end
		MarkDirty()
	end

	ApplyGlobalAccent = function(col)
		Theme.Accent = col
		for _, name in ipairs(UI.TabOrder) do
			local tObj = UI.Tabs[name]
			if tObj then
				tObj.TabColor = col
				tObj.ApplyContentAccent(col)
				if UI.ActiveTab == name then
					tObj.Label.TextColor3 = col
					tObj.Icon.ImageColor3 = col
					UI.ActiveTabLine.BackgroundColor3 = col
				end
			end
		end
		for _, sw in ipairs(SwitchRegistry) do
			sw.Refresh(true)
		end
		MarkDirty()
	end

